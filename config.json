{
  "workspace_root": "~/code",
  "data_dir": "~/.local/share/claude-code-bridge",
  "server": {
    "host": "0.0.0.0",
    "port": 4010,
    "token_file": "~/.config/claude-code-bridge/token"
  },
  "discovery": {
    "depth": 1,
    "exclusions": [
      "node_modules",
      "claude-code-bridge"
    ]
  },
  "limits": {
    "max_concurrent_jobs": 2,
    "job_timeout_minutes": 30,
    "max_cost_usd": 20,
    "list_jobs_max": 50
  },
  "clone": {
    "depth": 1,
    "timeout_seconds": 600,
    "max_size_mb": 2048,
    "hosts": [
      {
        "host": "github.com",
        "type": "github"
      },
      {
        "host": "git.gnrl.tech",
        "type": "gitea"
      }
    ]
  },
  "claude": {
    "bin": "claude",
    "extra_args": [],
    "branch_prefix": "bridge/",
    "commit_author": "Claude Code Bridge <claude-code-bridge@localhost>"
  },
  "projects": {
    "form-submissions": {
      "job_timeout_minutes": 30,
      "max_cost_usd": 8,
      "tier": "default"
    },
    "beyond-ims-website": {
      "note": "PRODUCTION deploy checkout: the live Beyond IMS website Docker stack (Next.js web + Cloudflare tunnel) builds from THIS directory. Publishing a merged change = update_checkout here, then compose_redeploy. For development tasks use bnd-ims-website (clean working copy of the same repo)."
    },
    "bnd-ims-website": {
      "note": "Clean working copy of Beyond-One-AU/beyond-ims-website for development tasks (start_task here). Production serves from the beyond-ims-website checkout \u2014 deploy there after merging."
    }
  },
  "models": {
    "default_tier": "default",
    "complex_tier": "complex",
    "tiers": {
      "default": {
        "model": "claude-opus-5",
        "max_cost_usd": 20,
        "aliases": [
          "opus"
        ]
      },
      "complex": {
        "model": "claude-fable-5-1",
        "max_cost_usd": 20,
        "aliases": [
          "fable",
          "fable-5-1"
        ],
        "effort": "high"
      }
    },
    "escalation": {
      "complex_agents": [
        "system-architect",
        "product-intent-guardian"
      ],
      "prompt_length_chars": 2500,
      "file_references": 6,
      "plan_without_claude_setup": true,
      "retry_after_failure": true
    }
  },
  "compose": {
    "protected": [
      "openui",
      "form-submissions",
      "dms-v3-form-submissions",
      "claude-code-bridge"
    ],
    "redeploy_timeout_minutes": 15,
    "restart_timeout_seconds": 180,
    "logs_default_lines": 200
  },
  "goals": {
    "_comment": "Goals group jobs across projects under one objective, one budget and one shared findings record. budget_usd covers ALL children together and is checked before each dispatch.",
    "budget_usd": 25
  }
}
